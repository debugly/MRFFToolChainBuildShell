From 2a66063488ef59131f603db5aa7316658a3901e4 Mon Sep 17 00:00:00 2001
From: qianlongxu <qianlongxu@gmail.com>
Date: Tue, 25 Aug 2026 11:45:55 +0800
Subject: [PATCH] add bd_open_fs function

---
 meson.build               |  2 +-
 src/libbluray/bluray-fs.h | 29 +++++++++++++++++++++++++++++
 src/libbluray/bluray.c    | 19 ++++++++++++++++++-
 src/libbluray/bluray.h    | 11 +++++++++++
 src/libbluray/disc/disc.h | 12 +-----------
 src/libbluray/meson.build |  1 +
 6 files changed, 61 insertions(+), 13 deletions(-)
 create mode 100644 src/libbluray/bluray-fs.h

diff --git a/meson.build b/meson.build
index 6cea3f7..9e5e897 100644
--- a/meson.build
+++ b/meson.build
@@ -20,7 +20,7 @@ cdata = configuration_data()
 add_project_arguments('-DHAVE_CONFIG_H=1', language: 'c')
 
 # Include directories
-libbluray_inc_dirs = [include_directories('.', 'src', 'src/libbluray', 'src/libbluray/disc')]
+libbluray_inc_dirs = [include_directories('.', 'src', 'src/libbluray', 'src/libbluray/disc', 'src/file')]
 
 # The version number for the shared library
 libbluray_soname_version = '4.0.0'
diff --git a/src/libbluray/bluray-fs.h b/src/libbluray/bluray-fs.h
new file mode 100644
index 0000000..3946df7
--- /dev/null
+++ b/src/libbluray/bluray-fs.h
@@ -0,0 +1,29 @@
+#ifndef _BLURAY_FS_H_
+#define _BLURAY_FS_H_
+
+#include <stdint.h>
+#include <unistd.h>
+#include "filesystem.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* application provided file system access (optional) */
+typedef struct fs_access {
+    void *fs_handle;
+
+    /* method 1: block (device) access */
+    int (*read_blocks)(void *fs_handle, void *buf, int lba, int num_blocks);
+
+    /* method 2: file access */
+    struct bd_dir_s  *(*open_dir) (void *fs_handle, const char *rel_path);
+    struct bd_file_s *(*open_file)(void *fs_handle, const char *rel_path);
+    void             (*close_fs)  (void *fs_handle);
+} fs_access;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif //_BLURAY_FS_H_
diff --git a/src/libbluray/bluray.c b/src/libbluray/bluray.c
index f5f5f55..aa4880b 100644
--- a/src/libbluray/bluray.c
+++ b/src/libbluray/bluray.c
@@ -22,7 +22,7 @@
 #if HAVE_CONFIG_H
 #include "config.h"
 #endif
-
+#include "bluray-fs.h"
 #include "bluray-version.h"
 #include "bluray.h"
 #include "player_settings.h"
@@ -4337,3 +4337,20 @@ void bd_free_bdjo(struct bdjo_data *obj)
 {
     bdjo_free(&obj);
 }
+
+BLURAY *bd_open_fs(const char *device_path, const char *keyfile_path, fs_access *p_fs)
+{
+    BLURAY *bd;
+
+    bd = bd_init();
+    if (!bd) {
+        return NULL;
+    }
+
+    if (!_bd_open(bd, device_path, keyfile_path, p_fs)) {
+        bd_close(bd);
+        return NULL;
+    }
+
+    return bd;
+}
diff --git a/src/libbluray/bluray.h b/src/libbluray/bluray.h
index 95d551a..e8a3c2e 100644
--- a/src/libbluray/bluray.h
+++ b/src/libbluray/bluray.h
@@ -1289,6 +1289,17 @@ BD_PUBLIC struct bd_dir_s *bd_open_dir(BLURAY *bd, const char *dir);
  */
 BD_PUBLIC struct bd_file_s *bd_open_file_dec(BLURAY *bd, const char *path);
 
+
+/**
+ * Open a BluRay disc from an custom file system.
+ *
+ * @param device_path   device path (for AACS keys)
+ * @param keyfile_path  path to keyfile (optional)
+ * @param p_fs          custom file system access struct
+ * @return BLURAY object, NULL on error
+ */
+BD_PUBLIC BLURAY *bd_open_fs(const char *device_path, const char *keyfile_path, struct fs_access *p_fs);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/libbluray/disc/disc.h b/src/libbluray/disc/disc.h
index 418c5b1..29a6b2d 100644
--- a/src/libbluray/disc/disc.h
+++ b/src/libbluray/disc/disc.h
@@ -29,17 +29,7 @@ struct bd_file_s;
 struct bd_dir_s;
 struct bd_enc_info;
 
-/* application provided file system access (optional) */
-typedef struct fs_access {
-    void *fs_handle;
-
-    /* method 1: block (device) access */
-    int (*read_blocks)(void *fs_handle, void *buf, int lba, int num_blocks);
-
-    /* method 2: file access */
-    struct bd_dir_s  *(*open_dir) (void *fs_handle, const char *rel_path);
-    struct bd_file_s *(*open_file)(void *fs_handle, const char *rel_path);
-} fs_access;
+#include "bluray-fs.h"
 
 /*
  * BluRay Virtual File System
diff --git a/src/libbluray/meson.build b/src/libbluray/meson.build
index e0dcb91..89e5e1e 100644
--- a/src/libbluray/meson.build
+++ b/src/libbluray/meson.build
@@ -3,6 +3,7 @@
 
 libbluray_internal_headers = []
 libbluray_api_headers = files(
+    'bluray-fs.h',
     '../file/filesystem.h',
     '../util/log_control.h',
     'bluray.h',
